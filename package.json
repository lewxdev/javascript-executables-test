{
  "name": "javascript-executables-test",
  "version": "0.1.0",
  "scripts": {
    "build:get-pkg:bun": "bun run scripts/build.bun.js src/get-pkg.js",
    "build:get-pkg:deno": "deno run -A scripts/build.deno.js src/get-pkg.js",
    "build:get-pkg:node": "node scripts/build.node.js src/get-pkg.js",
    "build:get:bun": "bun run scripts/build.bun.js src/get.js",
    "build:get:deno": "deno run -A scripts/build.deno.js src/get.js"
  },
  "dependencies": {
    "ora": "^9.3.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@types/node": "^25"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "version": "1.3.9"
      },
      {
        "name": "deno",
        "version": "2.6.10"
      },
      {
        "name": "npm",
        "version": "11.10.1"
      }
    ],
    "runtime": [
      {
        "name": "bun",
        "version": "1.3.9"
      },
      {
        "name": "deno",
        "version": "2.6.10"
      },
      {
        "name": "node",
        "version": "25.7.0"
      }
    ]
  },
  "private": true,
  "type": "module"
}
